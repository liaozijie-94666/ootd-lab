# ---- Database ----
# 默认使用内置 PGlite（WASM PostgreSQL），数据落在 .data/pgdata
# 生产 / Netlify：DB_DRIVER=postgres，DATABASE_URL 用 Supabase 连接池
DB_DRIVER=pglite
DATABASE_URL=postgresql://user:pass@localhost:5432/ootd
# Supabase 填 Session pooler（5432），仅迁移使用
DIRECT_URL=

# ---- Media ----
OOTD_DATA_DIR=.data
# 32 bytes base64；生产必须配置，开发可留空使用派生密钥
MEDIA_KEK=
# 签名媒体 URL 的 HMAC 密钥；留空回退 AUTH_SECRET
MEDIA_URL_SECRET=
# local（默认）或 supabase；Netlify 必须用 supabase
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=ootd-media
# Netlify 函数请求体约 6MB，默认压到 4MB
MAX_UPLOAD_BYTES=4194304

# ---- 任务执行 ----
# async（本地默认）或 sync（Netlify / Serverless 必须）
INLINE_TASK_MODE=async

# ---- Demo identity（M1 登录体系上线前使用）----
DEMO_USER_EMAIL=demo@ootd.local

# ---- Auth.js ----
# openssl rand -base64 32；生产必须设置，否则会话无法验签
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---- AI 推荐 ----
# mock：规则引擎，无需 Key；llm：走 OpenAI 兼容接口（密钥只在服务端）
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- Image Generation（虚拟试衣 / 效果图）----
# 供应商链：按顺序降级，未配置 Key 的会被跳过，最终回退 mock
IMAGE_PROVIDER_CHAIN=mock
IMAGE_MAX_ATTEMPTS=3
APP_URL=http://localhost:3000
# Webhook HMAC 密钥（生产必填）；为空时 webhook 返回 503
IMAGE_WEBHOOK_SECRET=
IMAGE_SAFETY_PROVIDER=mock

# Fashn（虚拟试衣）
FASHN_API_KEY=
FASHN_BASE_URL=https://api.fashn.ai/v1

# Replicate（通用模型；IDM-VTON 用独立 version）
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=
REPLICATE_IDM_VTON_VERSION=

# ComfyUI（自建；workflow 为 API 格式 JSON，支持 {{prompt}} 等占位符）
COMFYUI_BASE_URL=
COMFYUI_API_KEY=
COMFYUI_WORKFLOW_PATH=

# Stable Diffusion WebUI / A1111
SD_API_URL=
SD_API_KEY=
SD_MODEL=
SD_STEPS=28
SD_CFG=6
SD_SAMPLER=DPM++ 2M Karras
SD_DENOISING=0.55

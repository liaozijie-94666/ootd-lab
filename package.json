{
  "name": "ootd-lab",
  "version": "0.1.0",
  "private": true,
  "description": "OOTD Lab — AI 穿搭推荐网站",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "prisma generate && tsx scripts/ensure-db.ts && tsx scripts/run-next.ts dev",
    "build": "prisma generate && next build",
    "start": "tsx scripts/ensure-db.ts --migrate-only && tsx scripts/run-next.ts start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:init": "tsx scripts/ensure-db.ts",
    "db:seed": "tsx scripts/ensure-db.ts",
    "setup": "tsx scripts/ensure-db.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@prisma/client": "6.16.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.90.2",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "pglite-prisma-adapter": "0.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "^5.5.6",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "dotenv": "^17.2.3",
    "prisma": "6.16.2",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
